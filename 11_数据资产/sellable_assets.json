  "整改代码库": [
    {
      "缺什么": "JSON-LD 结构化数据",
      "影响分值": 25,
      "修法": "在 <head> 里加 Organization + WebSite + Service",
      "代码": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\"@type\":\"Organization\",\"name\":\"公司全称\",\"url\":\"https://官网/\",\"logo\":\"https://官网/logo.png\"},\n    {\"@type\":\"WebSite\",\"name\":\"公司简称\",\"url\":\"https://官网/\"},\n    {\"@type\":\"Service\",\"name\":\"主营业务\",\"provider\":{\"@type\":\"Organization\"}}\n  ]\n}\n</script>",
      "注意": "注意用 @graph 包一层 —— 这是 Google 推荐写法，很多工具（含我们自己的早期版本）不认顶层 @type。"
    },
    {
      "缺什么": "llms.txt",
      "影响分值": 10,
      "修法": "站点根目录放一个 llms.txt，说明你是谁、提供什么",
      "代码": "# 公司全称\n\n> 一句话说明你提供什么服务。\n\n## 我们做什么\n- 业务一\n- 业务二\n\n## 联系\n- 官网：https://官网/\n- 邮箱：business@官网域名\n",
      "注意": "AI 爬虫优先读这个文件；没有它，AI 只能猜你是谁。"
    },
    {
      "缺什么": "FAQ 结构化数据",
      "影响分值": 15,
      "修法": "把常见问答写成 FAQPage，AI 才好直接引用你的答案",
      "代码": "<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"客户会问的问题\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"直接给结论的答案\"}}]}\n</script>",
      "注意": "答案第一句就要有结论。AI 摘取的就是第一句。"
    },
    {
      "缺什么": "robots.txt 放行 AI 爬虫",
      "影响分值": 30,
      "修法": "别写 Disallow: /；显式放行主要 AI 爬虫",
      "代码": "User-agent: GPTBot\nAllow: /\n\nUser-agent: ClaudeBot\nAllow: /\n\nUser-agent: PerplexityBot\nAllow: /\n\nUser-agent: *\nDisallow: /admin\nDisallow: /cart\n\nSitemap: https://官网/sitemap.xml\n",
      "注意": "实测国内 21 家一家都没拦 AI。拦住 AI 是自伤，不是保护。"
    }
  ],
