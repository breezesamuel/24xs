# SMTP 告警通道（hidden_watchdog.mjs 读取）
# QQ 邮箱：设置 -> 账户 -> 开启 SMTP 服务 -> 生成 16 位授权码填入 SMTP_AUTH
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_AUTH=your_16char_smtp_authcode
SMTP_TO=your_account@qq.com

# 收银台基址（KV 兜底告警）
STOREFRONT_BASE=https://tools.highkingflower.com

# 可选：GitHub 写权限 token（爬虫/线索采集用；缺失则降级）
# GH_TOKEN=ghp_xxx

# 可选：AI 摘要 Key（缺失则降级）
# OPENROUTER_API_KEY=sk-or-xxx
